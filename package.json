{
  "name": "echo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Voice-first taste agent built on the Qloo taste graph",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "qloo:probe": "node --env-file-if-exists=.env.local scripts/qloo-probe.mjs",
    "qloo:seed": "tsx scripts/seed-qloo-cache.ts",
    "qloo:seed:db": "tsx --env-file-if-exists=.env.local scripts/seed-qloo-cache.ts --db",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "claude:check": "tsx --env-file-if-exists=.env.local scripts/claude-check.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.2",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  }
}
