# Copy this file to .env.local and fill in your values. .env.local is gitignored.
# On Vercel, set the same variables under Project → Settings → Environment Variables
# (everything except SUPABASE_DB_URL, which only the migration script uses).

# --- Required -------------------------------------------------------------
ANTHROPIC_API_KEY=
QLOO_API_KEY=
# Hackathon keys only work on this host. Host only, without /v2.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# --- Supabase (accounts, saved data, invites, shared Qloo cache) -----------
# Project Settings → API. Without these the app keeps data in the browser only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Connect → Session pooler connection string. Used by `npm run db:migrate` only.
SUPABASE_DB_URL=

# --- Claude spend guardrail -------------------------------------------------
# Global cap on Claude spend per UTC day, in dollars (default 0.30). Counted
# from actual token usage across all users, local dev and production.
AI_DAILY_BUDGET_USD=

# --- Qloo quota guardrails --------------------------------------------------
# Live Qloo calls are off unless this is 1. Off, only cached responses are used.
QLOO_LIVE=
# Live calls allowed per UTC day (default 300).
QLOO_DAILY_CAP=
# Stop when Qloo reports this many calls left this month (default 3000).
QLOO_MONTHLY_RESERVE=
# Set to "file" to use the local file cache even when Supabase is configured.
QLOO_CACHE=

# --- Optional -----------------------------------------------------------------
# Where the Qloo probe tests place searches. Defaults to Lower Manhattan.
TEST_LAT=
TEST_LON=
