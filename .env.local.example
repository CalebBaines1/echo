# Copy this file to .env.local and fill in your values. .env.local is gitignored.

# Required
QLOO_API_KEY=

# Optional: the host Qloo gave you. Defaults to https://hackathon.api.qloo.com (hackathon keys only work there)
# Use the host only, without /v2 (the script adds paths itself).
QLOO_BASE_URL=

# Optional: where to test place searches. Defaults to Lower Manhattan.
TEST_LAT=
TEST_LON=
